# SynapseNet Node Configuration
# Copy to ~/.synapsenet/synapsenet.conf

# Tor — the desktop app starts a session Tor (SOCKS + ControlPort) and publishes
# a new v3 onion via ADD_ONION on every launch. Closing the app kills that Tor.
# Optional extra bootstrap peers (onion or hostname). Empty = mesh via your onion.
# network.seed_nodes=example.onion:8333
network.seed_nodes=
network.port=8333
network.rpc_port=8332

# Tor Privacy Mode
agent.tor.required=true
agent.tor.mode=external
tor.socks.host=127.0.0.1
tor.socks.port=9050
tor.control.port=9151
agent.tor.socks_host=127.0.0.1
agent.tor.socks_port=9050
agent.routing.allow_clearnet_fallback=false
agent.routing.allow_p2p_clearnet_fallback=false

# UPnP/NAT-PMP punch holes on the LAN router. Off for anonymity.
network.enable_upnp=false
network.enable_natpmp=false
